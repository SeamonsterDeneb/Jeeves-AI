rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /stories/{storyId} {
    allow read, write: if request.auth != null;
    }
    match /voiceProfiles/{docId} {
    allow read, write: if request.auth != null;
    }
    // Allow anyone to submit a suggestion, but only pulsipherd can read, update, or delete them
    match /suggestions/{suggestionId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'pulsipherd@gmail.com';
    }
    // Allow users to have their api keys saved automatically to firestore
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
